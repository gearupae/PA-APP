# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql+asyncpg://paapp:paapp@localhost:5432/paapp

# --- Redis (workers / cache) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# --- Mail OAuth (Phase 2) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/mail/accounts/oauth/callback/gmail

MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/mail/accounts/oauth/callback/outlook

# Optional: max messages per sync job
# MAIL_SYNC_RECENT_LIMIT=20

# --- Mobile (optional overrides) ---
# API_BASE_URL=http://10.0.2.2:8000

# --- Recordings (Phase 7) ---
# RECORDING_STORAGE_URL=s3://bucket/prefix
# RECORDING_RETENTION_DAYS=90
# STT_PROVIDER=whisper  # stub | whisper | openai
# LLM_PROVIDER=stub
